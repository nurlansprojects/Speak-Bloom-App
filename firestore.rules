rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'cookingmaxxer@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'nurlandigital@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrappedAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isCourseTeacher(courseId) {
      return isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        (courseId != null && courseId != '' &&
         exists(/databases/$(database)/documents/courses/$(courseId)) &&
         (get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == 'instructor_sarah'))
      );
    }

    function isValidUploadedFile(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128
        && data.scope in ['teacher_resource', 'student_submission']
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255
        && data.fileType in ['audio', 'video', 'document', 'spreadsheet', 'presentation', 'image']
        && data.fileExtension is string && data.fileExtension.size() > 0 && data.fileExtension.size() <= 10
        && data.fileSize is number && data.fileSize >= 0 && data.fileSize <= 104857600
        && data.fileUrl is string && data.fileUrl.size() > 0
        && data.storagePath is string && data.storagePath.size() > 0;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && (request.resource.data.role in ['student', 'teacher'] || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          request.resource.data.role == resource.data.role ||
          request.resource.data.role in ['student', 'teacher']
        ))
      );
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teacher Applications
    match /teacherApplications/{applicationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow get: if isSignedIn() && (
        resource.data.status == 'published' ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.teacherId == request.auth.uid || isTeacher() || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == request.auth.uid) ||
        isTeacher()
      );
      allow delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());

      // Course Subcollections
      match /modules/{moduleId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isCourseTeacher(courseId) || isAdmin());
      }

      match /topics/{topicId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isCourseTeacher(courseId) || isAdmin());
      }

      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isCourseTeacher(courseId) || isAdmin());
      }

      match /activities/{activityId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isCourseTeacher(courseId) || isAdmin());
      }
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isCourseTeacher(resource.data.courseId)
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isCourseTeacher(resource.data.courseId)
      );
      allow delete: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isCourseTeacher(resource.data.courseId) ||
        isAdmin()
      );
    }

    // Lesson Progress (Mastery Gates)
    match /progress/{progressId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isCourseTeacher(resource.data.courseId)
      );
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isCourseTeacher(request.resource.data.courseId)
      );
      allow delete: if isSignedIn() && (
        isCourseTeacher(resource.data.courseId) ||
        isAdmin()
      );
    }

    // Assessment Attempts & Rubrics
    match /assessmentAttempts/{attemptId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin() ||
        isCourseTeacher(resource.data.courseId)
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        isCourseTeacher(resource.data.courseId)
      );
      allow delete: if isSignedIn() && (
        isCourseTeacher(resource.data.courseId) ||
        isAdmin()
      );
    }

    // Uploaded Files (Shared Uploading feature for Teachers and Students)
    match /uploads/{uploadId} {
      // Read access:
      // - Teacher resources can be read by any signed-in student or teacher
      // - Student private submissions can only be read by the owner, course teacher, or admin
      allow get: if isSignedIn() && (
        resource.data.scope == 'teacher_resource' ||
        resource.data.userId == request.auth.uid ||
        isCourseTeacher(resource.data.courseId) ||
        isTeacher() ||
        isAdmin()
      );
      allow list: if isSignedIn();

      // Create access:
      // - Must be signed in, uploading as themselves (prevent impersonation)
      // - Must validate schema: required fields, types, 100MB limit, valid extension & category
      // - If uploading student_submission: authorized for any signed-in student
      // - If uploading teacher_resource: user must be course teacher, verified teacher, admin, or uploader declaring teacher role
      allow create: if isSignedIn() &&
        isValidUploadedFile(request.resource.data) &&
        (
          request.resource.data.scope == 'student_submission' ||
          (request.resource.data.scope == 'teacher_resource' && (
            isCourseTeacher(request.resource.data.courseId) ||
            isTeacher() ||
            isAdmin() ||
            (request.resource.data.userId == request.auth.uid && request.resource.data.userRole in ['teacher', 'admin'])
          ))
        );

      // Update access:
      // - Owner can update their title/instructions/metadata without altering ownership or scope
      // - Course teacher or Admin can add feedback, grade, and review status to student submissions
      // - Students CANNOT modify teacher-owned files or submissions belonging to others
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.scope == resource.data.scope
        ) ||
        (
          (isCourseTeacher(resource.data.courseId) || isTeacher() || isAdmin()) &&
          resource.data.scope == 'student_submission' &&
          request.resource.data.userId == resource.data.userId
        )
      );

      // Delete access:
      // - Students can delete their own uploads
      // - Course teacher or admin can delete all uploads belonging to the course during course cleanup
      // - Teachers and admins can delete teacher resources
      // - Students CANNOT delete teacher-owned files
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTeacher(resource.data.courseId) ||
        (resource.data.scope == 'teacher_resource' && (isTeacher() || isAdmin())) ||
        isAdmin()
      );
    }
  }
}
